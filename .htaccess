Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a carpetas internas
    RewriteRule ^(includes|pages)(/|$) - [F,L]
    RewriteRule ^routes\.php$ - [F,L]

    # Archivos y carpetas que existen (css, js, imágenes) se sirven tal cual
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !\.php$
    RewriteRule ^ - [L]

    # Todo lo demás pasa por el controlador frontal
    RewriteRule ^ index.php [L,QSA]
</IfModule>
